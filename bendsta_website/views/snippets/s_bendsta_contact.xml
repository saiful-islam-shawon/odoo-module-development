<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="s_bendsta_contact"
              name="BENDSTA Contact &amp; Location">

        <section class="s_bendsta_contact"
                 data-snippet="s_bendsta_contact"
                 data-name="BENDSTA Contact &amp; Location">

            <div class="container">

                <div class="row g-5 align-items-start">

                    <!-- ==================================
                         Left: Secretariat Details
                    =================================== -->

                    <div class="col-lg-5">

                        <div class="bendsta-contact-badge">
                            Headquarters &amp; Secretariat
                        </div>


                        <h2 class="bendsta-contact-title">
                            Official BENDSTA Secretariat Office
                        </h2>


                        <p class="bendsta-contact-description">
                            Engage directly with association leadership,
                            request policy documentation, or coordinate
                            stakeholder consultations.
                        </p>


                        <!-- Contact Information -->
                        <div class="bendsta-contact-info-list">


                            <!-- Address -->
                            <div class="bendsta-contact-info-card">

                                <div class="bendsta-contact-icon">

                                    <svg width="21"
                                         height="21"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         aria-hidden="true">

                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              stroke-width="2"
                                              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>

                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              stroke-width="2"
                                              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>

                                    </svg>

                                </div>


                                <div class="bendsta-contact-info-content">

                                    <div class="bendsta-contact-info-label">
                                        Secretariat Location
                                    </div>

                                    <div class="bendsta-contact-info-value">
                                        Alam Arcade, Plot 43 (New) 27 (Old),
                                        5th Floor,
                                        <br/>
                                        North Gulshan Commercial Area,
                                        Dhaka 1212, Bangladesh.
                                    </div>

                                </div>

                            </div>


                            <!-- Phone -->
                            <div class="bendsta-contact-info-card">

                                <div class="bendsta-contact-icon">

                                    <svg width="21"
                                         height="21"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         aria-hidden="true">

                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              stroke-width="2"
                                              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>

                                    </svg>

                                </div>


                                <div class="bendsta-contact-info-content">

                                    <div class="bendsta-contact-info-label">
                                        Telephone Inquiries
                                    </div>

                                    <a href="tel:+8801793008486"
                                       class="bendsta-contact-info-link">
                                        +880 1793-008486
                                    </a>

                                </div>

                            </div>


                            <!-- Email -->
                            <div class="bendsta-contact-info-card">

                                <div class="bendsta-contact-icon">

                                    <svg width="21"
                                         height="21"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         aria-hidden="true">

                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              stroke-width="2"
                                              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>

                                    </svg>

                                </div>


                                <div class="bendsta-contact-info-content">

                                    <div class="bendsta-contact-info-label">
                                        Official Secretariat Email
                                    </div>

                                    <a href="mailto:gs.bendsta@gmail.com"
                                       class="bendsta-contact-info-link">
                                        gs.bendsta@gmail.com
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ==================================
                         Right: Map
                    =================================== -->

                    <div class="col-lg-7">

                        <div class="bendsta-contact-map-card">


                            <!-- Map Header -->
                            <div class="bendsta-contact-map-header">

                                <div>

                                    <div class="bendsta-contact-map-eyebrow">
                                        Geographic Verification
                                    </div>

                                    <h3 class="bendsta-contact-map-title">
                                        Dhaka Secretariat Headquarters
                                    </h3>

                                </div>


                                <a href="https://www.google.com/maps/search/?api=1&amp;query=Alam+Arcade%2C+43+Felani+Ave%2C+Dhaka+1212"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="bendsta-contact-map-button">

                                    <span>
                                        Google Maps
                                    </span>

                                    <svg width="13"
                                         height="13"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         aria-hidden="true">

                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              stroke-width="2"
                                              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>

                                    </svg>

                                </a>

                            </div>


                            <!-- Google Map -->
                            <div class="bendsta-contact-map">

                                <iframe
                                    title="BENDSTA Office Map"
                                    src="https://www.google.com/maps?q=Alam%20Arcade%2C%2043%20Felani%20Ave%2C%20Dhaka%201212&amp;output=embed"
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade">
                                </iframe>

                            </div>


                            <!-- Map Description -->
                            <p class="bendsta-contact-map-description">
                                Conveniently located in the North Gulshan
                                Commercial Area, Dhaka. Official delegation
                                meetings and technical regulatory working
                                group sessions are scheduled via prior
                                appointment.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </section>

    </template>

</odoo>