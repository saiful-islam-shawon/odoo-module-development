<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_compliance_joining_letter_list" model="ir.ui.view">
        <field name="name">compliance.joining.letter.list</field>
        <field name="model">compliance.joining.letter</field>

        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="contract_date_start"/>
                <field name="mobile"/>
            </list>
        </field>
    </record>


    <!-- Form View -->
    <record id="view_compliance_joining_letter_form" model="ir.ui.view">
        <field name="name">compliance.joining.letter.form</field>
        <field name="model">compliance.joining.letter</field>

        <field name="arch" type="xml">

            <form string="চাকরি যোগদান পত্র">

                <header>

                    <button
                        name="action_print_report"
                        string="Print"
                        type="object"
                        class="btn-primary"
                    />

                </header>

                <sheet>

                    <separator string="কর্মচারীর তথ্য"/>

                    <group>

                        <group>
                            <field name="employee_id"/>
                            <field name="mobile"/>
                            <field name="email"/>
                        </group>

                        <group>
                            <field name="receiver_name"/>
                            <field name="job_id" readonly="1"/>
                            <field name="contract_date_start" readonly="1"/>
                        </group>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- Window Action -->
    <record id="action_compliance_joining_letter"
            model="ir.actions.act_window">

        <field name="name">Joining Letter</field>
        <field name="res_model">compliance.joining.letter</field>
        <field name="view_mode">list,form</field>

    </record>

</odoo>