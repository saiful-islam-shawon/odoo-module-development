<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_employee_form_inherit_compliance_report"
            model="ir.ui.view">

        <field name="name">
            hr.employee.form.inherit.compliance.report
        </field>

        <field name="model">hr.employee</field>

        <field name="inherit_id"
               ref="hr.view_employee_form"/>

        <field name="arch" type="xml">


            <!-- =================================================
                 PERSONAL TAB
                 Add Others group after Documents
            ================================================== -->

            <xpath
                expr="//group[@name='hr_document_group']"
                position="after"
            >

                <group
                    name="compliance_others_group"
                    string="Others"
                >

                    <field name="father_name"/>

                    <field name="mother_name"/>

                    <field name="present_address"/>

                    <field name="experience"/>

                    <field
                        name="employee_signature"
                        widget="image"
                        class="oe_avatar"
                        options="{'size': [180, 100]}"
                    />

                    <field name="nominee_form_date"/>
                    <field name="salary_account_no"/>
                    <field name="total_children"/>
                    <field name="daughter_count"/>
                    <field name="son_count"/>

                    <field name="fitness_certificate_date"/>
                    <field name="physical_fitness"/>
                    <field name="identification_mark"/>

                </group>


                <group
                    name="compliance_appointment_information"
                    string="Appointment Information"
                >

                    <field name="appointment_letter_date"/>

                    <field name="job_application_date"/>

                    <field name="joining_date"/>

                    <field name="compliance_grade"/>

                    <field name="probation_months"/>

                    <field name="extended_probation_months"/>

                </group>

            </xpath>


            <!-- =================================================
                 NEW COMPLIANCE INFORMATION TAB
            ================================================== -->

            <xpath
                expr="//page[@name='hr_settings']"
                position="after"
            >

                <page
                    name="compliance_information"
                    string="Compliance Information"
                >

                    <group>

                        <group
                            name="compliance_money_provided"
                            string="Money Provided"
                        >
                        
                            <field name="basic" readonly="1"/>
                            <field name="compliance_house_rent" readonly="1"/>
                            <field name="medical_allowance"/>
                            <field name="transport_allowance"/>
                            <field name="other_allowance"/>
                            <field name="food_allowance"/>

                            <!-- Auto Calculated -->
                            <field name="gro"/>

                            <field name="attendance_bonus"/>

                            <!-- Deductions -->
                            <field name="earn_salary"/>
                            <field name="absent_amount"/>
                            <field name="deduction"/>
                            <field name="tax"/>
                            <field name="stamp_charge"/>

                            <!-- Auto Calculated -->
                            <field name="net_salary_display" readonly="1"/>

                            <field name="increment_amount"/>
                            <field name="revision_date"/>

                        </group>

                    </group>


                    <!-- =============================================
                        COMPLIANCE ATTENDANCE
                    ============================================== -->

                    <group
                        name="compliance_attendance"
                        string="Compliance Attendance"
                    >

                        <field name="present_days"/>

                        <field name="weekly_holiday"/>

                        <field name="general_holiday"/>

                        <field name="earned_leave"/>

                        <field name="casual_leave"/>

                        <field name="sick_leave"/>

                        <field name="maternity_leave"/>

                        <field name="absent_days"/>

                        <field name="total_payable_days"/>

                    </group>

                </page>


                <!-- Nominee Form Tab -->
                <page
                    name="employee_nominee_form"
                    string="Nominee Form"
                >

                    <separator string="Nominee Information"/>

                    <field name="nominee_ids" nolabel="1">

                        <list>
                            <field name="name"/>
                            <field name="nid"/>
                            <field name="date_of_birth"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="relation"/>
                            <field name="share_percentage" string="Share %"/>
                        </list>


                        <form string="Nominee Information">

                            <sheet>

                                <div class="oe_title">
                                    <h2>Nominee Information</h2>
                                </div>

                                <group>

                                    <group string="Personal Information">

                                        <field name="name"/>
                                        <field name="nid"/>
                                        <field name="date_of_birth"/>
                                        <field name="age" readonly="1"/>
                                        <field name="gender"/>
                                        <field name="permanent_address"/>

                                    </group>

                                    <group string="Nominee Details">

                                        <field name="relation"/>
                                        <field name="share_percentage"/>

                                        <field
                                            name="photo"
                                            widget="image"
                                            class="oe_avatar"
                                        />

                                        <field name="document"/>

                                    </group>

                                </group>

                            </sheet>

                        </form>

                    </field>

                </page>

            </xpath>


            <!-- =================================================
                PAYROLL TAB - OTHERS
            ================================================== -->

            <xpath
                expr="//page[@name='payroll_information']//field[@name='resource_calendar_id']"
                position="after"
            >

                <!-- Others Section -->

                <separator
                    name="compliance_payroll_others"
                    string="Others"
                />


                <!-- Mobile Bill -->

                <field name="mobile_bill"/>


                <!-- Attendance Bonus -->

                <label for="attendance_bonus"/>

                <div class="o_row">

                    <field
                        name="attendance_bonus"
                        nolabel="1"
                        class="oe_inline o_hr_narrow_field"
                    />

                    <span class="ms-2">
                        Per Month
                    </span>

                </div>

            </xpath>


        </field>

    </record>

</odoo>