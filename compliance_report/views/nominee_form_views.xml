<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_compliance_nominee_form_list" model="ir.ui.view">
        <field name="name">compliance.nominee.form.list</field>
        <field name="model">compliance.nominee.form</field>

        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="joining_date"/>
                <field name="form_date"/>
            </list>
        </field>
    </record>


    <!-- Form View -->
    <record id="view_compliance_nominee_form_form" model="ir.ui.view">

        <field name="name">compliance.nominee.form.form</field>
        <field name="model">compliance.nominee.form</field>

        <field name="arch" type="xml">

            <form string="Nominee Form">

                <header>
                    <button
                        name="action_print_report"
                        string="Print"
                        type="object"
                        class="btn-primary"
                    />
                </header>

                <sheet>

                    <separator string="কর্মকর্তা / কর্মচারীর তথ্য"/>

                    <group>

                        <group>
                            <field name="employee_id"/>
                            <field name="job_id"/>
                            <field name="joining_date"/>
                            <field name="salary_account_no"/>
                        </group>

                        <group>
                            <field name="form_date"/>
                            <field name="total_children"/>
                            <field name="daughter_count"/>
                            <field name="son_count"/>
                        </group>

                    </group>

                    <separator string="Nominee Information"/>

                    <field
                        name="nominee_ids"
                        nolabel="1"
                        readonly="1"
                    >

                        <list
                            create="0"
                            delete="0"
                            edit="0"
                        >
                            <field name="name"/>
                            <field name="nid"/>
                            <field name="date_of_birth"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="relation"/>
                            <field name="permanent_address"/>
                            <field name="share_percentage" string="Share %"/>
                        </list>

                    </field>

                </sheet>

            </form>

        </field>

    </record>


    <!-- Action -->
    <record id="action_compliance_nominee_form"
            model="ir.actions.act_window">

        <field name="name">Nominee Form</field>
        <field name="res_model">compliance.nominee.form</field>
        <field name="view_mode">list,form</field>

    </record>

</odoo>