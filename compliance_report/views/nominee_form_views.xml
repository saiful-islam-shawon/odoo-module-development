<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_compliance_nominee_form_list" model="ir.ui.view">
        <field name="name">compliance.nominee.form.list</field>
        <field name="model">compliance.nominee.form</field>

        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="joining_date"/>
                <field name="form_date"/>
            </list>
        </field>
    </record>


    <!-- Form View -->
    <record id="view_compliance_nominee_form_form" model="ir.ui.view">
        <field name="name">compliance.nominee.form.form</field>
        <field name="model">compliance.nominee.form</field>

        <field name="arch" type="xml">

            <form string="Nominee Form">

                <header>
                    <button
                        name="action_print_report"
                        string="Print"
                        type="object"
                        class="btn-primary"
                    />
                </header>

                <sheet>

                    <!-- Employee -->
                    <separator string="কর্মকর্তা / কর্মচারীর তথ্য"/>

                    <group>

                        <group>
                            <field name="employee_id"/>
                            <field name="job_id"/>
                            <field name="joining_date"/>
                            <field name="salary_account_no"/>
                        </group>

                        <group>
                            <field name="form_date"/>
                            <field name="total_children"/>
                            <field name="daughter_count"/>
                            <field name="son_count"/>
                        </group>

                    </group>


                    <!-- Nominee A -->
                    <separator string="নোমিনি (ক)"/>

                    <group>

                        <group>
                            <field name="nominee_a_name"/>
                            <field name="nominee_a_age"/>
                            <field name="nominee_a_relation"/>
                        </group>

                        <group>
                            <field name="nominee_a_address"/>
                            <field name="nominee_a_percentage"/>
                        </group>

                    </group>


                    <!-- Nominee B -->
                    <separator string="নোমিনি (খ)"/>

                    <group>

                        <group>
                            <field name="nominee_b_name"/>
                            <field name="nominee_b_age"/>
                            <field name="nominee_b_relation"/>
                        </group>

                        <group>
                            <field name="nominee_b_address"/>
                            <field name="nominee_b_percentage"/>
                        </group>

                    </group>


                    <!-- Photo -->
                    <separator string="নোমিনি ছবি"/>

                    <group>

                        <field
                            name="nominee_photo"
                            widget="image"
                            class="oe_avatar"
                            options="{'size': [180, 180]}"
                        />

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- Action -->
    <record id="action_compliance_nominee_form"
            model="ir.actions.act_window">

        <field name="name">Nominee Form</field>
        <field name="res_model">compliance.nominee.form</field>
        <field name="view_mode">list,form</field>

    </record>

</odoo>