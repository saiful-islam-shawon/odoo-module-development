<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_compliance_appointment_letter_list" model="ir.ui.view">
        <field name="name">compliance.appointment.letter.list</field>
        <field name="model">compliance.appointment.letter</field>

        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="grade"/>
                <field name="letter_date"/>
            </list>
        </field>
    </record>


    <record id="view_compliance_appointment_letter_form" model="ir.ui.view">
        <field name="name">compliance.appointment.letter.form</field>
        <field name="model">compliance.appointment.letter</field>

        <field name="arch" type="xml">

            <form string="Appointment Letter">

                <header>
                    <button
                        name="action_print_report"
                        string="Print"
                        type="object"
                        class="btn-primary"
                    />
                </header>

                <sheet>

                    <separator string="কর্মচারীর তথ্য"/>

                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="father_or_husband_name"/>
                            <field name="mother_name"/>
                            <field name="nid_number"/>
                            <field name="employee_code"/>
                        </group>

                        <group>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="permanent_address"/>
                            <field name="present_address"/>
                        </group>
                    </group>


                    <separator string="নিয়োগের তথ্য"/>

                    <group>
                        <group>
                            <field name="letter_date"/>
                            <field name="application_date"/>
                            <field name="appointment_date"/>
                        </group>

                        <group>
                            <field name="joining_date"/>
                            <field name="grade"/>
                            <field name="probation_months"/>
                            <field name="extended_probation_months"/>
                        </group>
                    </group>


                    <separator string="মজুরী ও ভাতাদি"/>

                    <group>
                        <group>
                            <field name="basic_wage"/>
                            <field name="house_rent"/>
                            <field name="medical_allowance"/>
                        </group>

                        <group>
                            <field name="conveyance_allowance"/>
                            <field name="food_allowance"/>
                            <field name="total_wage"/>
                            <field name="total_wage_words"/>
                        </group>
                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <record id="action_compliance_appointment_letter"
            model="ir.actions.act_window">

        <field name="name">Appointment Letter</field>
        <field name="res_model">compliance.appointment.letter</field>
        <field name="view_mode">list,form</field>

    </record>

</odoo>