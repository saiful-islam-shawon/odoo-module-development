<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =====================================================
         PAPER FORMAT
    ====================================================== -->

    <record id="paperformat_nominee_form"
            model="report.paperformat">

        <field name="name">Nominee Form A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>

        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">18</field>
        <field name="margin_right">18</field>

        <field name="header_line" eval="False"/>

    </record>


    <!-- =====================================================
         REPORT ACTION
    ====================================================== -->

    <record id="action_report_nominee_form"
            model="ir.actions.report">

        <field name="name">Nominee Form</field>
        <field name="model">compliance.nominee.form</field>
        <field name="report_type">qweb-pdf</field>

        <field name="report_name">compliance_report.report_nominee_form</field>

        <field name="report_file">compliance_report.report_nominee_form</field>

        <field
            name="paperformat_id"
            ref="compliance_report.paperformat_nominee_form"
        />

    </record>


    <!-- =====================================================
         QWEB REPORT
    ====================================================== -->

    <template id="report_nominee_form">

        <t t-call="web.html_container">

            <meta charset="UTF-8"/>

            <style>

                .nominee-page,
                .nominee-page * {
                    font-family: "Noto Sans Bengali", sans-serif !important;
                    box-sizing: border-box;
                }

                .nominee-page {
                    color: #000;
                    font-size: 16px;
                    line-height: 1.65;
                }


                /* =========================
                   HEADER
                ========================== */

                .report-header {
                    text-align: center;
                    line-height: 1.35;
                }

                .company-name {
                    font-family: sans-serif !important;
                    font-size: 23px;
                    font-weight: bold;
                }

                .company-address {
                    font-family: sans-serif !important;
                    font-size: 16px;
                }

                .report-title {
                    font-family: sans-serif !important;
                    font-size: 20px;
                    font-weight: bold;
                }

                .report-subtitle {
                    margin-top: 3px;
                    font-weight: bold;
                }

                .form-date {
                    text-align: right;
                    margin-top: 12px;
                    margin-bottom: 10px;
                }


                /* =========================
                   ROWS
                ========================== */

                .report-row {
                    margin-top: 6px;
                }

                .line {
                    display: inline-block;
                    min-height: 21px;
                    border-bottom: 1px solid #000;
                    padding: 0 4px;
                    vertical-align: baseline;
                }

                .section-title {
                    font-weight: bold;
                    margin-top: 14px;
                    margin-bottom: 8px;
                }


                /* =========================
                   NOMINEE
                ========================== */

                .nominee-card {
                    position: relative;
                    min-height: 190px;
                    margin-top: 12px;
                    padding-right: 135px;
                    page-break-inside: avoid;
                }

                .nominee-photo {
                    position: absolute;
                    top: 5px;
                    right: 0;
                    width: 110px;
                    height: 130px;
                    border: 1px solid #000;
                    text-align: center;
                    overflow: hidden;
                }

                .nominee-photo img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }

                .photo-placeholder {
                    padding-top: 43px;
                    line-height: 1.5;
                }

                .nominee-separator {
                    border: 0;
                    border-top: 1px solid #999;
                    margin-top: 12px;
                }


                /* =========================
                   SIGNATURE
                ========================== */

                .signature-line {
                    display: inline-block;
                    width: 210px;
                    min-height: 22px;
                    border-bottom: 1px solid #000;
                }


                /* =========================
                   NON-BREAKABLE
                   SIGNATURE GROUPS
                ========================== */

                .signature-group {
                    page-break-inside: avoid !important;
                    break-inside: avoid !important;
                }

                .owner-approval-group {
                    page-break-inside: avoid !important;
                    break-inside: avoid !important;
                }


                /* =========================
                   BULK PRINT

                   Employee 2+ starts from
                   a new physical PDF page.
                ========================== */

                .bulk-new-page {
                    page-break-before: always;
                    break-before: page;
                }

            </style>


            <!-- =================================================
                 RECORD LOOP
            ================================================== -->

            <t t-foreach="docs" t-as="o">


                <!-- =================================================
                     BULK EMPLOYEE SEPARATOR

                     First employee -> no break
                     Employee 2+ -> start on new page
                ================================================== -->

                <div
                    t-if="o_index != 0"
                    class="bulk-new-page"
                >
                </div>


                <!-- =================================================
                     CURRENT EMPLOYEE NOMINEE FORM
                ================================================== -->

                <div class="page nominee-page">


                    <!-- =================================================
                         HEADER
                    ================================================== -->

                    <div class="report-header">

                        <div class="company-name">
                            Khetan Trading
                        </div>

                        <div class="company-address">
                            Dewliabari, Konabari, Gazipur
                        </div>

                        <div class="report-title">
                            Nominee Form
                        </div>

                        <div class="report-subtitle">
                            প্রতিষ্ঠানের কর্মকর্তা ও কর্মচারীদের নোমিনি আবেদন ফর্ম
                        </div>

                    </div>


                    <!-- =================================================
                         DATE
                    ================================================== -->

                    <div class="form-date">

                        তারিখঃ

                        <span
                            class="line"
                            style="min-width: 170px;"
                        >

                            <t t-if="o.form_date">
                                <span t-field="o.form_date"/>
                            </t>

                        </span>

                    </div>


                    <!-- =================================================
                         EMPLOYEE
                    ================================================== -->

                    <div class="report-row">

                        ১। কর্মকর্তা/কর্মচারীর নামঃ

                        <span
                            class="line"
                            style="min-width: 410px;"
                        >

                            <t t-esc="
                                o.employee_id.name
                                if o.employee_id
                                else ''
                            "/>

                        </span>

                    </div>


                    <div class="report-row">

                        ২। পদবীঃ

                        <span
                            class="line"
                            style="min-width: 560px;"
                        >

                            <t t-esc="
                                o.job_id.name
                                if o.job_id
                                else ''
                            "/>

                        </span>

                    </div>


                    <div class="report-row">

                        ৩। যোগদানের তারিখঃ

                        <span
                            class="line"
                            style="min-width: 470px;"
                        >

                            <t t-if="o.joining_date">
                                <span t-field="o.joining_date"/>
                            </t>

                        </span>

                    </div>


                    <div class="report-row">

                        ৪। বেতনের হিসাব নং-

                        <span
                            class="line"
                            style="min-width: 470px;"
                        >

                            <t t-esc="o.salary_account_no or ''"/>

                        </span>

                    </div>


                    <div class="report-row">

                        ৫। সন্তান সংখ্যাঃ

                        <span
                            class="line"
                            style="min-width: 70px;"
                        >
                            <t t-esc="o.total_children or ''"/>
                        </span>

                        জন। মেয়েঃ

                        <span
                            class="line"
                            style="min-width: 70px;"
                        >
                            <t t-esc="o.daughter_count or ''"/>
                        </span>

                        জন। ছেলেঃ

                        <span
                            class="line"
                            style="min-width: 70px;"
                        >
                            <t t-esc="o.son_count or ''"/>
                        </span>

                    </div>


                    <!-- =================================================
                         NOMINEE SECTION
                    ================================================== -->

                    <div class="section-title">
                        ৬। নোমিনি (মনোনীত প্রার্থীর) পূর্ণবৃত্তান্তঃ
                    </div>


                    <t t-if="o.employee_id">

                        <t
                            t-foreach="o.employee_id.nominee_ids"
                            t-as="nominee"
                        >

                            <div class="nominee-card">


                                <!-- Serial -->

                                <div style="font-weight: bold;">

                                    নোমিনি

                                    <t t-esc="nominee_index + 1"/>

                                </div>


                                <!-- Name -->

                                <div class="report-row">

                                    নামঃ

                                    <span
                                        class="line"
                                        style="min-width: 420px;"
                                    >
                                        <t t-esc="nominee.name or ''"/>
                                    </span>

                                </div>


                                <!-- NID -->

                                <div class="report-row">

                                    জাতীয় পরিচয়পত্র নংঃ

                                    <span
                                        class="line"
                                        style="min-width: 310px;"
                                    >
                                        <t t-esc="nominee.nid or ''"/>
                                    </span>

                                </div>


                                <!-- Age / Gender -->

                                <div class="report-row">

                                    বয়সঃ

                                    <span
                                        class="line"
                                        style="min-width: 90px;"
                                    >
                                        <t t-esc="nominee.age or ''"/>
                                    </span>

                                    লিঙ্গঃ

                                    <span
                                        class="line"
                                        style="min-width: 100px;"
                                    >

                                        <t t-if="nominee.gender">

                                            <t t-esc="
                                                dict(
                                                    nominee._fields['gender']._description_selection(
                                                        nominee.env
                                                    )
                                                ).get(
                                                    nominee.gender,
                                                    ''
                                                )
                                            "/>

                                        </t>

                                    </span>

                                </div>


                                <!-- Relation -->

                                <div class="report-row">

                                    সম্পর্কঃ

                                    <span
                                        class="line"
                                        style="min-width: 350px;"
                                    >
                                        <t t-esc="nominee.relation or ''"/>
                                    </span>

                                </div>


                                <!-- Permanent Address -->

                                <div class="report-row">

                                    স্থায়ী ঠিকানাঃ

                                    <span
                                        class="line"
                                        style="min-width: 350px;"
                                    >
                                        <t t-esc="nominee.permanent_address or ''"/>
                                    </span>

                                </div>


                                <!-- Sample Signatures -->

                                <div class="report-row">

                                    নমুনা স্বাক্ষরঃ

                                    ১।

                                    <span
                                        class="line"
                                        style="min-width: 130px;"
                                    >
                                        &#160;
                                    </span>

                                    ২।

                                    <span
                                        class="line"
                                        style="min-width: 130px;"
                                    >
                                        &#160;
                                    </span>

                                </div>


                                <!-- Percentage -->

                                <div class="report-row">

                                    অর্থপ্রাপ্তির শতকরা হারঃ

                                    <span
                                        class="line"
                                        style="min-width: 100px;"
                                    >
                                        <t t-esc="nominee.share_percentage or ''"/>
                                    </span>

                                    %

                                </div>


                                <!-- Photo -->

                                <div class="nominee-photo">

                                    <t t-if="nominee.photo">

                                        <img
                                            t-att-src="image_data_uri(nominee.photo)"
                                            alt="Nominee Photo"
                                        />

                                    </t>

                                    <t t-else="">

                                        <div class="photo-placeholder">
                                            নোমিনি
                                            <br/>
                                            ছবি
                                        </div>

                                    </t>

                                </div>


                            </div>


                            <hr class="nominee-separator"/>


                        </t>

                    </t>


                    <!-- =================================================
                         GROUP 1
                         Applicant + HR Signature
                         Never split between pages
                    ================================================== -->

                    <div class="signature-group">

                        <table
                            style="
                                width: 100%;
                                margin-top: 35px;
                                border-collapse: collapse;
                                page-break-inside: avoid;
                            "
                        >

                            <tr>


                                <!-- Applicant Signature -->

                                <td
                                    style="
                                        width: 50%;
                                        text-align: center;
                                        vertical-align: bottom;
                                    "
                                >

                                    <div style="height: 45px;">
                                        &#160;
                                    </div>

                                    <span class="signature-line">
                                        &#160;
                                    </span>

                                    <br/>

                                    আবেদনকারীর স্বাক্ষর

                                </td>


                                <!-- HR Signature -->

                                <td
                                    style="
                                        width: 50%;
                                        text-align: center;
                                        vertical-align: bottom;
                                    "
                                >

                                    <div style="height: 45px;">
                                        &#160;
                                    </div>

                                    <span class="signature-line">
                                        &#160;
                                    </span>

                                    <br/>

                                    মানব সম্পদ বিভাগের স্বাক্ষর

                                </td>


                            </tr>

                        </table>

                    </div>


                    <!-- =================================================
                         GROUP 2
                         Owner Approval + Signature
                         Never split between pages
                    ================================================== -->

                    <div
                        class="owner-approval-group"
                        style="
                            margin-top: 35px;
                            page-break-inside: avoid;
                        "
                    >


                        <!-- Owner Approval Title -->

                        <div style="font-weight: bold;">
                            প্রতিষ্ঠান মালিকের অনুমোদনঃ
                        </div>


                        <!-- Owner Signature -->

                        <div
                            style="
                                margin-top: 25px;
                                width: 280px;
                                text-align: center;
                                page-break-inside: avoid;
                            "
                        >

                            <div style="height: 30px;">
                                &#160;
                            </div>

                            <span
                                class="signature-line"
                                style="width: 250px;"
                            >
                                &#160;
                            </span>

                        </div>


                    </div>


                </div>


            </t>

        </t>

    </template>

</odoo>