<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_amarpay_pay_now" model="ir.ui.view">
        <field name="name">res.partner.form.amarpay.pay.now</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button
                        name="action_amarpay_pay_now"
                        string="Pay Now"
                        type="object"
                        class="btn-primary"
                    />
                </header>
            </xpath>
        </field>
    </record>
</odoo>
