<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_amarpay" model="ir.ui.view">
        <field name="name">payment.provider.form.amarpay</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group invisible="code != 'amarpay'">
                    <field name="amarpay_store_id" required="code == 'amarpay'"/>
                    <field name="amarpay_signature_key" password="True" required="code == 'amarpay'"/>
                    <field name="amarpay_sandbox"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>