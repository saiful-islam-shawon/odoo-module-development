<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="redirect_form">
        <form t-att-action="api_url" method="get">
            <t t-foreach="amarpay_params or {}" t-as="param_key">
                <input type="hidden" t-att-name="param_key" t-att-value="amarpay_params[param_key]"/>
            </t>
        </form>
    </template>

    <template id="amarpay_pay_now_redirect">
        <html>
            <head>
                <title>Redirecting to Aamarpay</title>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
            </head>
            <body>
                <div style="font-family: Arial, sans-serif; text-align: center; padding: 60px 20px;">
                    <h3>Redirecting to Aamarpay...</h3>
                    <p>Please wait while we open the secure payment page.</p>
                    <t t-out="redirect_form_html"/>
                </div>
                <script type="text/javascript">
                    document.addEventListener('DOMContentLoaded', function () {
                        var form = document.querySelector('form');
                        if (form) {
                            form.submit();
                        }
                    });
                </script>
            </body>
        </html>
    </template>

    <template id="amarpay_pay_now_error">
        <html>
            <head>
                <title>Aamarpay Payment Error</title>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
            </head>
            <body>
                <div style="font-family: Arial, sans-serif; max-width: 700px; margin: 60px auto; padding: 20px;">
                    <h3>Aamarpay payment could not be started.</h3>
                    <p t-out="message"/>
                    <a href="/web">Back to Odoo</a>
                </div>
            </body>
        </html>
    </template>


    <!-- default payment message show -->
    <template id="amarpay_pay_now_status">
        <html>
            <head>
                <title>Payment Status - Aamarpay</title>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <meta charset="utf-8"/>
                <style>
                    * {
                        box-sizing: border-box;
                        margin: 0;
                        padding: 0;
                    }
                    body {
                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                        background-color: #f8fafc;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        min-height: 100vh;
                        padding: 20px;
                        color: #333333;
                    }
                    .status-card {
                        background: #ffffff;
                        border: 1px solid #e5e7eb;
                        border-radius: 16px;
                        max-width: 480px;
                        width: 100%;
                        padding: 40px 32px;
                        text-align: center;
                        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
                    }
                    .icon-badge {
                        width: 72px;
                        height: 72px;
                        border-radius: 50%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        margin: 0 auto 20px;
                    }
                    .badge-success {
                        background-color: #ecfdf5;
                    }
                    .badge-failed {
                        background-color: #fef2f2;
                    }
                    /* Pure CSS Checkmark */
                    .css-checkmark {
                        display: inline-block;
                        width: 20px;
                        height: 36px;
                        border: solid #71BF44;
                        border-width: 0 4px 4px 0;
                        transform: rotate(45deg);
                        margin-bottom: 8px;
                    }
                    /* Pure CSS Cross */
                    .css-cross {
                        position: relative;
                        width: 32px;
                        height: 32px;
                    }
                    .css-cross::before,
                    .css-cross::after {
                        content: '';
                        position: absolute;
                        top: 14px;
                        left: 0;
                        width: 32px;
                        height: 4px;
                        background-color: #ef4444;
                        border-radius: 2px;
                    }
                    .css-cross::before {
                        transform: rotate(45deg);
                    }
                    .css-cross::after {
                        transform: rotate(-45deg);
                    }
                    .status-title {
                        font-size: 22px;
                        font-weight: 700;
                        color: #0D508B;
                        margin-bottom: 12px;
                    }
                    .status-title.error {
                        color: #dc2626;
                    }
                    .status-message {
                        font-size: 15px;
                        color: #4b5563;
                        line-height: 1.6;
                        margin-bottom: 20px;
                        word-break: break-word;
                    }
                    .redirect-timer {
                        font-size: 14px;
                        color: #6b7280;
                        margin-bottom: 24px;
                    }
                    .countdown-badge {
                        font-weight: 700;
                        color: #0D508B;
                        background: #f1f5f9;
                        padding: 2px 8px;
                        border-radius: 6px;
                    }
                    .action-btn {
                        display: inline-block;
                        width: 100%;
                        background-color: #71BF44;
                        color: #ffffff;
                        text-decoration: none;
                        font-weight: 600;
                        font-size: 15px;
                        padding: 12px 24px;
                        border-radius: 8px;
                        transition: background-color 0.2s ease;
                    }
                    .action-btn:hover {
                        background-color: #5fa637;
                    }
                </style>
            </head>
            <body>
                <div class="status-card">
                    <!-- Pure CSS Success Icon -->
                    <div t-if="is_success" class="icon-badge badge-success">
                        <span class="css-checkmark"></span>
                    </div>

                    <!-- Pure CSS Failed Icon -->
                    <div t-if="not is_success" class="icon-badge badge-failed">
                        <span class="css-cross"></span>
                    </div>

                    <!-- Status Titles -->
                    <h2 t-if="is_success" class="status-title">Payment Successful</h2>
                    <h2 t-if="not is_success" class="status-title error">Payment Failed</h2>

                    <!-- Message -->
                    <p class="status-message" t-out="message"/>

                    <!-- Timer info -->
                    <p class="redirect-timer">
                        Redirecting back in <span id="amarpay_countdown" class="countdown-badge">3</span> seconds...
                    </p>

                    <!-- Button -->
                    <a t-att-href="redirect_url" class="action-btn">Go Back Now</a>
                </div>

                <script type="text/javascript">
                    var seconds = 3;
                    var el = document.getElementById('amarpay_countdown');
                    var timer = setInterval(function () {
                        seconds -= 1;
                        if (el) { el.textContent = seconds; }
                        if (seconds &lt;= 0) {
                            clearInterval(timer);
                            window.location.href = "<t t-out="redirect_url"/>";
                        }
                    }, 1000);
                </script>
            </body>
        </html>
    </template>
</odoo>
