<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amarpay_pay_now_wizard_form" model="ir.ui.view">
        <field name="name">amarpay.pay.now.wizard.form</field>
        <field name="model">amarpay.pay.now.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay Now">
                <group>
                    <field name="source_partner_id" invisible="1"/>
                    <field name="payer_name"/>
                    <field name="payer_phone"/>
                    <field name="payer_email" widget="email"/>
                    <field name="payer_address"/>
                    <field name="amount"/>
                    <field name="currency_id" options="{'no_open': True}"/>
                </group>
                <footer>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                    <button name="action_pay_now" string="Pay Now" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
