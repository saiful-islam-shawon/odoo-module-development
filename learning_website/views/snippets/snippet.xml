<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_snippet_template" inherit_id="website.snippets" name="Custom Snippet Template">

        <!-- create group -->
        <xpath expr="//snippets[@id='snippet_groups']" position="inside">
            <t snippet-group="zencore" t-snippet="website.s_snippet_group" string="Zencore"
                t-thumbnail="/website/static/src/img/snippets_thumbs/s_media_list.svg"/>
        </xpath>

        <!-- create snippet -->
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            
            <!-- company card -->
            <t t-snippet="learning_website.company_card_template" string="Company Card" group="zencore">
                <keywords>hero, jumbotron, headline, header, branding, intro, home, showcase, spotlight, lead, welcome, announcement, splash, top, main</keywords>
            </t>

            <!-- hero section -->
            <t t-snippet="learning_website.herosection_template" string="Company Card" group="zencore">
                <keywords>hero, jumbotron, headline, header, branding, intro, home, showcase, spotlight, lead, welcome, announcement, splash, top, main</keywords>
            </t>

            <!-- company card step-->
            <t t-snippet="learning_website.company_card_step_template" string="Company Card Step" group="zencore">
                <keywords>hero, jumbotron, headline, header, branding, intro, home, showcase, spotlight, lead, welcome, announcement, splash, top, main</keywords>
            </t>
        </xpath>
    </template>

</odoo>
