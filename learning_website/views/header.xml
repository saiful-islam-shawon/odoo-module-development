<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_header"
              name="Custom Header"
              inherit_id="website.template_header_default"
              priority="100">

        <!-- শুধু default desktop navbar replace করছি -->
        <xpath expr="//t[@t-call='website.navbar']"
               position="replace">

            <t t-call="website.navbar"
               _navbar_classes.f="d-none d-lg-block shadow-sm">

                <div id="o_main_nav"
                     class="o_main_nav container d-flex align-items-center">

                    <!-- Odoo dynamic brand/logo -->
                    <t t-call="website.placeholder_header_brand"
                       _link_class.f="custom_navbar_brand me-4 custom_brand"/>

                    <!-- Odoo dynamic menus -->
                    <t t-call="website.navbar_nav"
                       _nav_class.f="custom_navbar_menu me-auto">

                        <t t-foreach="website.menu_id.child_id"
                           t-as="submenu">

                            <t t-call="website.submenu"
                               item_class.f="nav-item"
                               link_class.f="nav-link"/>

                        </t>

                    </t>

                    <!-- Right-side actions -->
                    <ul class="custom_header_actions navbar-nav
                               flex-row align-items-center gap-2 ms-auto">

                        <!-- Odoo default search -->
                        <t t-call="website.placeholder_header_search_box"
                           _layout.f="modal"
                           _input_classes.f="border border-end-0 p-3"
                           _submit_classes.f="border border-start-0 px-4"
                           _button_classes.f="custom_search_button text-reset"/>

                        <!-- Public user sign-in -->
                        <t t-call="portal.placeholder_user_sign_in"
                           _link_class.f="custom_sign_in nav-link"/>

                        <!-- Logged-in user dropdown -->
                        <t t-call="portal.user_dropdown"
                           _user_name="True"
                           _item_class.f="dropdown"
                           _link_class.f="custom_user_menu nav-link border-0"
                           _dropdown_menu_class.f="dropdown-menu-end"/>

                    </ul>

                </div>

            </t>

        </xpath>

    </template>

</odoo>