<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="approval_line_model_view_form" model="ir.ui.view">
        <field name="name">approval_line_model.view.form</field>
        <field name="model">sale.order.approval.line</field>
        <field name="arch" type="xml">
            <form>

                <group>
                    <group>
                        <field name="sale_order_id" readonly="1"/>
                        <field name="approval_level" readonly="1"/>
                        <field name="validity_date" readonly="1"></field>
                        <field name="status" readonly="1"/>

                    </group>

                    <group>
                        <field name="user_id" readonly="1"/>
                        <field name="approve_date" readonly="1"></field>
                        <field name="new_date" readonly="1"></field>
                    </group>
                </group>

                <footer>

                    <button
                        name="action_approve"
                        string="Approve"
                        type="object"
                        class="btn-primary"
                        invisible="status != 'pending'"/>

                    <button
                        name="action_reject"
                        string="Reject"
                        type="object"
                        class="btn-danger"
                        invisible="status != 'pending'"/>

                    <button
                        special="cancel"
                        string="Cancel"/>

                </footer>

            </form>
        </field>
    </record>

</odoo>
