<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view" model="ir.ui.view">
        <field name="name">Sale Order View</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"></field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='validity_date']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <!-- add page after other information -->
            <xpath expr="//page[@name='other_information']" position="after">
                <page name="pi_expiary" string="PI Expiary" groups="zencore_groups.group_zencore_clm_ccm,zencore_groups.group_zencore_clm_finance">


                    <separator string="Approval History"/>

                    <field name="approval_line_ids">

                        <list create="false" delete="false">

                            <field name="user_id"/>

                            <field name="approval_level"/>

                            <field name="approve_date"/>

                            <field
                                name="status"
                                widget="badge"
                                decoration-warning="status == 'pending'"
                                decoration-success="status == 'approved'"
                                decoration-danger="status == 'rejected'"/>

                        </list>

                    </field>


                </page>
            </xpath>
        </field>
    </record>


</odoo>