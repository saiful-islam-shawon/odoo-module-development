<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Client Action: Connects menu to OWL JS Component -->
    <record id="action_map_learning_dashboard" model="ir.actions.client">
        <field name="name">Map Learning</field>
        <field name="tag">map_learning_action</field>
    </record>

    <!-- 2. Main Root Menu -->
    <menuitem id="menu_map_learning_root" 
              name="Map Learning"/>

    <!-- 3. Sub Menu under Root Menu -->
    <menuitem id="menu_map_learning_dashboard" 
              name="Leaflet Map" 
              parent="menu_map_learning_root" 
              action="action_map_learning_dashboard"/>
</odoo>