<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_bkash" model="ir.ui.view">
        <field name="name">payment.provider.form.bkash</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group invisible="code != 'bkash'">
                    <field name="bkash_app_key" required="code == 'bkash' and state != 'disabled'"/>
                    <field name="bkash_app_secret" password="True" required="code == 'bkash' and state != 'disabled'"/>
                    <field name="bkash_username" required="code == 'bkash' and state != 'disabled'"/>
                    <field name="bkash_password" password="True" required="code == 'bkash' and state != 'disabled'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>