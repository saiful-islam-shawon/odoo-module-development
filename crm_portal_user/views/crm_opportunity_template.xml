<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="crm_opportunity_template" name="Create CRM Opportunity">

        <t t-call="website.layout">

            <t t-set="additional_title">Create Opportunity</t>

            <div id="wrap" class="oe_structure crm_opportunity_page">

                <div class="container py-5">

                    <!-- Success Message -->
                    <div t-if="request.params.get('success')"
                         class="custom_success_banner">

                        <div class="custom_success_icon">
                            <i class="fa fa-check"/>
                        </div>

                        <div class="custom_success_text">
                            <h5>Opportunity Submitted</h5>
                            <p>
                                The CRM opportunity has been created successfully.
                            </p>
                        </div>

                    </div>

                    <!-- Header -->
                    <div class="mb-4">

                        <h2 class="mb-1">
                            Create Opportunity
                        </h2>

                        <p class="text-muted mb-0">
                            Submit customer information to create a CRM opportunity.
                        </p>

                    </div>


                    <section>

                        <form id="crm_opportunity_form"
                              action="/crm/opportunity/submit"
                              method="post"
                              enctype="multipart/form-data"
                              class="o_mark_required"
                              data-mark="*">

                            <input type="hidden"
                                   name="csrf_token"
                                   t-att-value="request.csrf_token()"/>

                            <div class="s_website_form_rows row s_col_no_bgcolor">

                                <!-- Opportunity Title -->
                                <div class="s_website_form_field mb-3 col-lg-6 col-12"
                                     data-type="char"
                                     data-name="Opportunity Title">

                                    <label class="form-label"
                                           for="crm_opportunity_name">
                                        Opportunity Title
                                        <span class="text-danger">*</span>
                                    </label>

                                    <input type="text"
                                           id="crm_opportunity_name"
                                           name="name"
                                           class="form-control"
                                           placeholder="For example: Website Development"
                                           required="required"/>

                                </div>


                                <!-- Contact Name -->
                                <div class="s_website_form_field mb-3 col-lg-6 col-12">

                                    <label class="form-label"
                                           for="crm_contact_name">
                                        Contact Name
                                        <span class="text-danger">*</span>
                                    </label>

                                    <input type="text"
                                           id="crm_contact_name"
                                           name="contact_name"
                                           class="form-control"
                                           placeholder="Customer contact name"
                                           required="required"/>

                                </div>


                                <!-- Company -->
                                <div class="mb-3 col-lg-6 col-12">

                                    <label class="form-label"
                                           for="crm_company_name">
                                        Company Name
                                    </label>

                                    <input type="text"
                                           id="crm_company_name"
                                           name="partner_name"
                                           class="form-control"
                                           placeholder="Customer company name"/>

                                </div>


                                <!-- Job -->
                                <div class="mb-3 col-lg-6 col-12">

                                    <label class="form-label"
                                           for="crm_function">
                                        Job Position
                                    </label>

                                    <input type="text"
                                           id="crm_function"
                                           name="function"
                                           class="form-control"
                                           placeholder="For example: Managing Director"/>

                                </div>


                                <!-- Email -->
                                <div class="mb-3 col-lg-6 col-12">

                                    <label class="form-label"
                                           for="crm_email">
                                        Email
                                        <span class="text-danger">*</span>
                                    </label>

                                    <input type="email"
                                           id="crm_email"
                                           name="email_from"
                                           class="form-control"
                                           placeholder="customer@example.com"
                                           required="required"/>

                                </div>


                                <!-- Phone -->
                                <div class="mb-3 col-lg-6 col-12">

                                    <label class="form-label"
                                           for="crm_phone">
                                        Phone
                                    </label>

                                    <input type="tel"
                                           id="crm_phone"
                                           name="phone"
                                           class="form-control"
                                           placeholder="+880 1XXXXXXXXX"/>

                                </div>


                                <!-- Website -->
                                <div class="mb-3 col-lg-6 col-12">

                                    <label class="form-label"
                                           for="crm_website">
                                        Website
                                    </label>

                                    <input type="url"
                                           id="crm_website"
                                           name="website"
                                           class="form-control"
                                           placeholder="https://example.com"/>

                                </div>


                                <!-- Referred -->
                                <div class="mb-3 col-lg-6 col-12">

                                    <label class="form-label"
                                           for="crm_referred">
                                        Referred By
                                    </label>

                                    <input type="text"
                                           id="crm_referred"
                                           name="referred"
                                           class="form-control"
                                           placeholder="Referral source"/>

                                </div>


                                <!-- Revenue -->
                                <div class="mb-3 col-lg-6 col-12">

                                    <label class="form-label"
                                           for="crm_expected_revenue">
                                        Expected Revenue
                                    </label>

                                    <input type="number"
                                           id="crm_expected_revenue"
                                           name="expected_revenue"
                                           class="form-control"
                                           min="0"
                                           step="0.01"
                                           placeholder="0.00"/>

                                </div>


                                <!-- Closing Date -->
                                <div class="mb-3 col-lg-6 col-12">

                                    <label class="form-label"
                                           for="crm_date_deadline">
                                        Expected Closing Date
                                    </label>

                                    <input type="date"
                                           id="crm_date_deadline"
                                           name="date_deadline"
                                           class="form-control"/>

                                </div>


                                <!-- Tags -->
                                <div class="mb-3 col-12">

                                    <label class="form-label">
                                        Tags
                                    </label>

                                    <input type="hidden"
                                           id="crm_tag_ids"
                                           name="tag_ids"
                                           value=""/>

                                    <div class="dropdown crm_tags_dropdown">

                                        <div class="crm_tag_selector dropdown-toggle"
                                             id="crm_tag_selector"
                                             role="button"
                                             data-bs-toggle="dropdown"
                                             data-bs-auto-close="outside">

                                            <div class="crm_selected_tags">
                                                <span class="crm_tag_placeholder">
                                                    Select tags...
                                                </span>
                                            </div>

                                            <i class="fa fa-angle-down crm_tag_dropdown_icon"/>

                                        </div>

                                        <div class="dropdown-menu crm_tags_dropdown_menu">

                                            <div class="crm_tag_search_wrapper">

                                                <i class="fa fa-search"/>

                                                <input type="text"
                                                       class="form-control crm_tag_search"
                                                       placeholder="Search tags..."/>

                                            </div>

                                            <div class="crm_tag_options">

                                                <t t-foreach="crm_tags" t-as="tag">

                                                    <label class="crm_tag_option"
                                                           t-att-data-tag-name="tag.name.lower()">

                                                        <input type="checkbox"
                                                               class="crm_tag_option_input"
                                                               t-att-value="tag.id"
                                                               t-att-data-tag-name="tag.name"/>

                                                        <span class="crm_tag_checkmark">
                                                            <i class="fa fa-check"/>
                                                        </span>

                                                        <span class="crm_tag_option_name">
                                                            <t t-esc="tag.name"/>
                                                        </span>

                                                    </label>

                                                </t>

                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <!-- Address Header -->
                                <div class="col-12 mt-3 mb-2">

                                    <h5>Address Information</h5>
                                    <hr/>

                                </div>


                                <!-- Street -->
                                <div class="mb-3 col-lg-6 col-12">

                                    <label class="form-label">
                                        Street
                                    </label>

                                    <input type="text"
                                           name="street"
                                           class="form-control"
                                           t-att-value="partner.street or ''"/>

                                </div>


                                <!-- Street 2 -->
                                <div class="mb-3 col-lg-6 col-12">

                                    <label class="form-label">
                                        Street 2
                                    </label>

                                    <input type="text"
                                           name="street2"
                                           class="form-control"
                                           t-att-value="partner.street2 or ''"/>

                                </div>


                                <!-- City -->
                                <div class="mb-3 col-lg-4 col-12">

                                    <label class="form-label">
                                        City
                                    </label>

                                    <input type="text"
                                           name="city"
                                           class="form-control"
                                           t-att-value="partner.city or ''"/>

                                </div>


                                <!-- ZIP -->
                                <div class="mb-3 col-lg-4 col-12">

                                    <label class="form-label">
                                        ZIP / Postal Code
                                    </label>

                                    <input type="text"
                                           name="zip"
                                           class="form-control"
                                           t-att-value="partner.zip or ''"/>

                                </div>


                                <!-- Country -->
                                <div class="mb-3 col-lg-4 col-12">

                                    <label class="form-label"
                                           for="crm_country_search">
                                        Country
                                    </label>

                                    <input type="hidden"
                                           id="crm_country_id"
                                           name="country_id"
                                           t-att-value="partner.country_id.id if partner.country_id else ''"/>

                                    <div class="position-relative crm_country_search_wrapper">

                                        <input type="text"
                                               id="crm_country_search"
                                               class="form-control"
                                               autocomplete="off"
                                               placeholder="Select Country"
                                               t-att-value="partner.country_id.name if partner.country_id else ''"/>

                                        <div id="crm_country_suggestions"
                                             class="crm_country_suggestions_dropdown d-none">

                                            <t t-foreach="crm_countries"
                                               t-as="country">

                                                <div class="crm_country_suggestion_item"
                                                     t-att-data-id="country.id"
                                                     t-att-data-name="country.name">

                                                    <t t-esc="country.name"/>

                                                </div>

                                            </t>

                                        </div>

                                    </div>

                                </div>


                                <!-- State -->
                                <div class="mb-3 col-lg-6 col-12">

                                    <label class="form-label"
                                           for="crm_state_search">
                                        State
                                    </label>

                                    <input type="hidden"
                                           id="crm_state_id"
                                           name="state_id"
                                           t-att-value="partner.state_id.id if partner.state_id else ''"/>

                                    <div class="position-relative crm_state_search_wrapper">

                                        <input type="text"
                                               id="crm_state_search"
                                               class="form-control"
                                               autocomplete="off"
                                               placeholder="Select State"
                                               t-att-value="partner.state_id.name if partner.state_id else ''"/>

                                        <div id="crm_state_suggestions"
                                             class="crm_state_suggestions_dropdown d-none">

                                            <t t-foreach="crm_states"
                                               t-as="state">

                                                <div class="crm_state_suggestion_item"
                                                     t-att-data-id="state.id"
                                                     t-att-data-name="state.name"
                                                     t-att-data-country-id="state.country_id.id">

                                                    <t t-esc="state.name"/>

                                                </div>

                                            </t>

                                        </div>

                                    </div>

                                </div>


                                <!-- Marketing -->
                                <div class="col-12 mt-4 mb-2">

                                    <h5>Marketing Information</h5>
                                    <hr/>

                                </div>


                                <!-- Campaign -->
                                <div class="mb-3 col-lg-6 col-12">

                                    <label class="form-label">
                                        Campaign
                                    </label>

                                    <input type="hidden"
                                           id="crm_campaign_id"
                                           name="campaign_id"/>

                                    <div class="position-relative crm_campaign_search_wrapper">

                                        <input type="text"
                                               id="crm_campaign_search"
                                               class="form-control"
                                               autocomplete="off"
                                               placeholder="Select Campaign"/>

                                        <div id="crm_campaign_suggestions"
                                             class="crm_campaign_suggestions_dropdown d-none">

                                            <t t-foreach="crm_campaigns"
                                               t-as="campaign">

                                                <div class="crm_campaign_suggestion_item"
                                                     t-att-data-id="campaign.id"
                                                     t-att-data-name="campaign.name">

                                                    <t t-esc="campaign.name"/>

                                                </div>

                                            </t>

                                        </div>

                                    </div>

                                </div>


                                <!-- Medium -->
                                <div class="mb-3 col-lg-6 col-12">

                                    <label class="form-label">
                                        Medium
                                    </label>

                                    <input type="hidden"
                                           id="crm_medium_id"
                                           name="medium_id"/>

                                    <div class="position-relative crm_medium_search_wrapper">

                                        <input type="text"
                                               id="crm_medium_search"
                                               class="form-control"
                                               autocomplete="off"
                                               placeholder="Select Medium"/>

                                        <div id="crm_medium_suggestions"
                                             class="crm_medium_suggestions_dropdown d-none">

                                            <t t-foreach="crm_mediums" t-as="medium">

                                                <div class="crm_medium_suggestion_item"
                                                     t-att-data-id="medium.id"
                                                     t-att-data-name="medium.name">

                                                    <t t-esc="medium.name"/>

                                                </div>

                                            </t>

                                        </div>

                                    </div>

                                </div>


                                <!-- Source -->
                                <div class="mb-3 col-lg-6 col-12">

                                    <label class="form-label">
                                        Source
                                    </label>

                                    <input type="hidden"
                                           id="crm_source_id"
                                           name="source_id"/>

                                    <div class="position-relative crm_source_search_wrapper">

                                        <input type="text"
                                               id="crm_source_search"
                                               class="form-control"
                                               autocomplete="off"
                                               placeholder="Select Source"/>

                                        <div id="crm_source_suggestions"
                                             class="crm_source_suggestions_dropdown d-none">

                                            <t t-foreach="crm_sources" t-as="source">

                                                <div class="crm_source_suggestion_item"
                                                     t-att-data-id="source.id"
                                                     t-att-data-name="source.name">

                                                    <t t-esc="source.name"/>

                                                </div>

                                            </t>

                                        </div>

                                    </div>

                                </div>


                                <!-- Description -->
                                <div class="mb-3 col-12">

                                    <label class="form-label">
                                        Requirements / Notes
                                    </label>

                                    <textarea name="description"
                                              class="form-control"
                                              rows="5"
                                              placeholder="Write the customer's requirements..."></textarea>

                                </div>


                                <!-- Submit -->
                                <div class="col-12 text-end py-2">

                                    <button type="submit"
                                            class="btn btn-primary px-4">

                                        <i class="fa fa-paper-plane me-2"/>

                                        Submit Opportunity

                                    </button>

                                </div>

                            </div>

                        </form>

                    </section>

                </div>

            </div>

        </t>

    </template>

</odoo>