<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_left_sidebar" name="Custom Left Sidebar">

        <aside class="custom_dashboard_sidebar">

            <nav class="custom_sidebar_nav">

                <a href="/"
                   t-attf-class="custom_sidebar_item #{'active' if active_menu == 'dashboard' else ''}">
                    <i class="fa fa-th-large"/>
                    <span>Dashboard</span>
                </a>

                <a href="/event"
                   t-attf-class="custom_sidebar_item #{'active' if active_menu == 'news' else ''}">
                    <i class="fa fa-newspaper-o"/>
                    <span>News &amp; Events</span>
                </a>

                <a href="/product-information"
                   t-attf-class="custom_sidebar_item #{'active' if active_menu == 'products' else ''}">
                    <i class="fa fa-archive"/>
                    <span>Product Information</span>
                </a>

                <a href="/documents"
                   t-attf-class="custom_sidebar_item #{'active' if active_menu == 'documents' else ''}">
                    <i class="fa fa-file-text-o"/>
                    <span>Documents</span>
                </a>

                <a href="/quick-view"
                   t-attf-class="custom_sidebar_item #{'active' if active_menu == 'quick_view' else ''}">
                    <i class="fa fa-eye"/>
                    <span>Quick View</span>
                </a>

                <a href="/hr-form-submission"
                   t-attf-class="custom_sidebar_item #{'active' if active_menu == 'hr_form' else ''}">
                    <i class="fa fa-paperclip"/>
                    <span>HR Form Submission</span>
                </a>

                <a href="/settings"
                   t-attf-class="custom_sidebar_item #{'active' if active_menu == 'settings' else ''}">
                    <i class="fa fa-cog"/>
                    <span>Settings</span>
                </a>

                <a href="/web/session/logout?redirect=/web/login"
                   class="custom_sidebar_item">
                    <i class="fa fa-sign-out"/>
                    <span>Logout</span>
                </a>

            </nav>

        </aside>

    </template>

</odoo>